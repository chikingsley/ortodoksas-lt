{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/vitest"
  ],
  "files": {
    "includes": [
      "!node_modules",
      "!.wrangler",
      "!dist",
      "!docs/revival",
      "!index.html",
      "!public/archive",
      "!public/content",
      "!public/original.html",
      "!recovery",
      "!scripts/recovery-*.mjs",
      "!scripts",
      "!src/app.tsx",
      "!src/components/ui",
      "!src/lib/content.ts",
      "!src/main.tsx",
      "!src/pages/rss.xml.ts",
      "!src/pages/sitemap.xml.ts",
      "!src/**/*.astro",
      "!worker-configuration.d.ts"
    ]
  },
  "css": {
    "linter": { "enabled": false }
  }
}
