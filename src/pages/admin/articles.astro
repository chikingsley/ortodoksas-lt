---
import AdminIdentity from "../../components/admin/AdminIdentity.astro";
import AdminArticleInventory from "../../features/admin/AdminArticleInventory";
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Straipsniai · ortodoksas.lt redakcija">
  <header class="admin-topbar">
    <AdminIdentity compact />
    <nav aria-label="Redakcijos navigacija">
      <a class="active" href="/admin/articles">Straipsniai</a>
      <a href="/">Viešas puslapis</a>
    </nav>
    <div class="admin-session">
      <span>GS</span>
      <div><strong>Gintaras Sungaila</strong><small>Demonstracinė sesija</small></div>
    </div>
  </header>
  <main class="admin-workspace">
    <header class="admin-page-heading">
      <div>
        <h1>Straipsniai</h1>
        <p>Visas atkurtas ortodoksas.lt turinys vienoje redakcijos eilėje.</p>
      </div>
      <button type="button" disabled>Kurti straipsnį</button>
    </header>
    <AdminArticleInventory client:load />
  </main>
</AdminLayout>
