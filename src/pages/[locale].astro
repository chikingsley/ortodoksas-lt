---
import SiteLayout from "../layouts/SiteLayout.astro";
import { formatDate, getLocalizedArticles, localeShells, localeUi, type Locale } from "../lib/publication";

const copy: Record<Locale, { name: string; title: string; message: string }> = {
  en: { name: "English", title: "English edition", message: "No recovered English publications are available yet. The Lithuanian archive remains the source edition while translated material is being prepared." },
  ru: { name: "Русский", title: "Русское издание", message: "В восстановленном архиве пока нет публикаций на русском языке. Литовский архив остаётся исходным изданием до подготовки переводов." },
  uk: { name: "Українська", title: "Українське видання", message: "У відновленому архіві поки немає публікацій українською мовою. Литовський архів залишається основним виданням до підготовки перекладів." },
  be: { name: "Беларуская", title: "Беларускае выданне", message: "У адноўленым архіве пакуль няма публікацый на беларускай мове. Літоўскі архіў застаецца зыходным выданнем да падрыхтоўкі перакладаў." },
};

export function getStaticPaths() {
  return localeShells.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const language = copy[locale];
const entries = getLocalizedArticles(locale);
const localizedCopy = localeUi[locale];
---

<SiteLayout title={`${language.title} · ortodoksas.lt`} description={entries.length ? `${entries.length} ${localizedCopy.articles.toLocaleLowerCase(locale)} · ${language.title}.` : language.message} canonicalPath={`/${locale}`} lang={locale} locale={locale}>
  <main class="site-width language-shell">
    {entries.length ? <>
      <header class="page-intro">
        <div class="eyebrow">{language.name} · {locale.toUpperCase()}</div>
        <h1>{language.title}</h1>
        <p>{entries.length} {localizedCopy.articles.toLocaleLowerCase(locale)} · {localizedCopy.provenance}</p>
      </header>
      <div class="archive-list localized-list" id="articles">
        {entries.map((entry) => <article>
          <time datetime={entry.published ?? undefined}>{formatDate(entry.published, locale)}</time>
          <div><span>{entry.labels[0] ?? language.name}</span><h2><a href={`/${locale}${entry.path}`}>{entry.title}</a></h2><p>{entry.description}</p></div>
          <a aria-label={`${entry.title}`} href={`/${locale}${entry.path}`}>→</a>
        </article>)}
      </div>
    </> : <div class="shell-card">
      <div class="eyebrow">{language.name} · {locale.toUpperCase()}</div>
      <h1>{language.title}</h1>
      <p>{language.message}</p>
      <p class="shell-note">Authentic recovered content only · Autentiškas atkurtas turinys</p>
      <a class="text-link" href="/">{localizedCopy.backToLithuanian} →</a>
    </div>}
  </main>
</SiteLayout>
