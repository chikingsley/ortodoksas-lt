---
import SiteLayout from "../layouts/SiteLayout.astro";
import { cleanHtml, formatDate, pages, type ContentPage } from "../lib/publication";

export function getStaticPaths() {
  return pages.map((page) => ({
    params: { path: page.path.slice(1).replace(/\.html$/, "") },
    props: { page },
  }));
}

const { page } = Astro.props as { page: ContentPage };
const description = page.description || `${page.title} · ortodoksas.lt`;
const canonicalPath = page.path;
const articleSchema = page.kind === "article" ? {
  headline: page.title,
  datePublished: page.published ?? undefined,
  dateModified: page.published ?? undefined,
  articleSection: page.section,
  keywords: page.labels.join(", "),
  mainEntityOfPage: canonicalPath,
} : undefined;
---

<SiteLayout
  title={`${page.title} · ortodoksas.lt`}
  description={description}
  canonicalPath={canonicalPath}
  image={page.hero}
  type={page.kind === "article" ? "article" : "website"}
  jsonLd={articleSchema}
>
  <main class="article-page">
    <div class="site-width article-breadcrumbs">
      <a href="/">Pradžia</a><span aria-hidden="true">›</span>
      <a href={page.kind === "article" ? `/tema/${page.section.toLocaleLowerCase("lt").normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}` : "/archyvas"}>{page.kind === "page" ? "Informacija" : page.section}</a>
    </div>
    <article class="reading-column">
      <header class="article-header">
        <div class="eyebrow">{page.kind === "page" ? "ortodoksas.lt" : page.section}</div>
        <h1>{page.title}</h1>
        {page.published ? <div class="article-byline"><time datetime={page.published}>{formatDate(page.published)}</time><span>Atkurta iš {page.capture?.slice(0, 4) ?? "viešojo"} m. archyvo kopijos</span></div> : null}
        {page.hero ? <div class="article-hero"><img src={page.hero} alt="" fetchpriority="high" /></div> : null}
      </header>
      <div class="prose" set:html={cleanHtml(page.html)} />
      {page.labels.length > 0 ? <footer class="article-tags">{page.labels.map((label) => <span>{label}</span>)}</footer> : null}
    </article>
    <aside class="site-width archive-note">
      <span aria-hidden="true">☦</span>
      <p>Šis tekstas atkurtas iš paskutinės prieinamos viešos ortodoksas.lt archyvo kopijos. Išsaugotas originalus turinys ir nuorodos.{page.source ? <> <a href={page.source} rel="noreferrer">Šaltinis</a>.</> : null}</p>
    </aside>
  </main>
</SiteLayout>
