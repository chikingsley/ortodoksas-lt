{
  "name": "@ortodoksas-lt/studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm generate-routes && tsc -b && vite build",
    "build:production": "pnpm build",
    "cf-typegen": "wrangler types",
    "check": "pnpm generate-routes && ultracite check && tsc -b && pnpm test && vitest run --config vitest.node.config.ts && pnpm deploy:dry-run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "deploy": "pnpm build:production && wrangler deploy --config dist/server/wrangler.json",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy:dry-run:production": "pnpm build:production && wrangler deploy --config dist/server/wrangler.json --dry-run",
    "dev": "vite",
    "fix": "ultracite fix",
    "generate-routes": "tsr generate",
    "lint": "ultracite check",
    "preview": "pnpm run build && vite preview",
    "test": "pnpm build && node scripts/verify-client-bundle.mjs && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
