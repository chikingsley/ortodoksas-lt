{
  "name": "@ortodoksas-lt/studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm generate-routes && tsc -b && vite build",
    "build:production": "pnpm build",
    "cf-typegen": "wrangler types",
    "check": "pnpm generate-routes && pnpm -w lint && tsc -b && pnpm test && vitest run --config vitest.node.config.ts && pnpm deploy:dry-run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "deploy": "pnpm build:production && wrangler deploy --config dist/server/wrangler.json",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy:dry-run:production": "pnpm build:production && wrangler deploy --config dist/server/wrangler.json --dry-run",
    "dev": "vite",
    "fix": "ultracite fix",
    "generate-routes": "node --import @tanstack/router-cli --eval '' -- tsr generate",
    "lint": "pnpm -w lint",
    "preview": "pnpm run build && vite preview",
    "test": "pnpm build && node --test tests/client-bundle.test.mjs && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/tanstack-react-start": "1.7.10",
    "@clerk/ui": "^1.42.3",
    "@floating-ui/react": "^0.27.20",
    "@fontsource-variable/geist": "^5.3.0",
    "@ortodoksas-lt/content": "workspace:*",
    "@ortodoksas-lt/db": "workspace:*",
    "@ortodoksas-lt/editor": "workspace:*",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-table": "9.3.1",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-find-and-replace": "^3.32.2",
    "@tiptap/extension-highlight": "^3.32.2",
    "@tiptap/extension-horizontal-rule": "^3.32.2",
    "@tiptap/extension-link": "3.32.2",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extension-subscript": "^3.32.2",
    "@tiptap/extension-superscript": "^3.32.2",
    "@tiptap/extension-text-align": "^3.32.2",
    "@tiptap/extension-typography": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lodash.throttle": "^4.1.1",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hotkeys-hook": "^5.3.3",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/router-cli": "1.167.46",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "sass-embedded": "^1.107.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "ultracite": "8.1.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "packageManager": "pnpm@12.14.0"
}
