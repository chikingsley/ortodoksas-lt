{
  "name": "@ortodoksas-lt/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "build:production": "pnpm build",
    "cf:types": "wrangler types",
    "cf:types:check": "wrangler types --check",
    "check": "pnpm -w lint && pnpm cf:types:check && astro check && pnpm typecheck && pnpm test:react && astro build && pnpm test:worker && pnpm deploy:dry-run",
    "deploy": "pnpm build:production && wrangler deploy --config dist/server/wrangler.json",
    "deploy:dry-run": "wrangler deploy --config dist/server/wrangler.json --dry-run",
    "deploy:dry-run:production": "pnpm build:production && wrangler deploy --config dist/server/wrangler.json --dry-run",
    "dev": "astro dev",
    "fix": "ultracite fix",
    "preview": "astro preview",
    "test": "pnpm test:react && pnpm build && pnpm test:worker",
    "test:react": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.1",
    "@astrojs/react": "^7.1.0",
    "@base-ui/react": "^1.9.0",
    "@ortodoksas-lt/content": "workspace:*",
    "@ortodoksas-lt/db": "workspace:*",
    "@ortodoksas-lt/editor": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.35.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "astro": "^7.4.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "ultracite": "^8.0.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  },
  "packageManager": "pnpm@12.14.0"
}
