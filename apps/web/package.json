{
  "name": "@ortodoksas-lt/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "cf:types": "wrangler types",
    "cf:types:check": "wrangler types --check",
    "check": "ultracite check && pnpm media:check:source && pnpm cf:types:check && pnpm typecheck && pnpm test && pnpm build && pnpm media:check:dist && pnpm deploy:dry-run",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "deploy:dry-run": "wrangler deploy --config wrangler.jsonc --dry-run",
    "dev": "astro dev",
    "fix": "ultracite fix",
    "media:check:dist": "tsx scripts/check-media-integrity.ts dist",
    "media:check:homepage": "tsx scripts/check-media-integrity.ts source --scope homepage && tsx scripts/check-media-integrity.ts dist --scope homepage",
    "media:check:source": "tsx scripts/check-media-integrity.ts source",
    "preview": "astro preview",
    "preview:down": "bash scripts-preview.sh down",
    "preview:status": "bash scripts-preview.sh status",
    "preview:up": "bash scripts-preview.sh up",
    "test": "pnpm test:react && pnpm test:worker",
    "test:react": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "@astrojs/react": "^6.0.2",
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@ortodoksas-lt/content": "workspace:*",
    "@ortodoksas-lt/db": "workspace:*",
    "@ortodoksas-lt/editor": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.7",
    "@cloudflare/vite-plugin": "^1.51.0",
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "astro": "^7.1.6",
    "cheerio": "^1.2.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "ultracite": "^7.10.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.119.0"
  },
  "packageManager": "pnpm@11.7.0"
}
