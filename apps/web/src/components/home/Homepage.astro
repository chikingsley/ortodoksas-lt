---
import type { HomepageModel } from "../../lib/homepage";
import ArchivePanel from "../archive/ArchivePanel.astro";
import ArticleCard from "../publication/ArticleCard.astro";
import LeadStory from "../publication/LeadStory.astro";
import SectionHeader from "../publication/SectionHeader.astro";
import StoryRow from "../publication/StoryRow.astro";
import LibraryCallout from "./LibraryCallout.astro";
import ServiceBand from "./ServiceBand.astro";

interface Props {
  model: HomepageModel;
}

const { model } = Astro.props;
---

<main>
  {model.lead ? (
    <section class="relative mx-auto grid w-[min(1200px,calc(100%-64px))] grid-cols-[minmax(0,1.34fr)_minmax(390px,1fr)] gap-8 py-6 max-lg:grid-cols-1 max-sm:w-full max-sm:gap-[22px] max-sm:py-2">
      <LeadStory entry={model.lead} />
      <div class="grid content-start max-lg:grid-cols-3 max-lg:gap-5 max-sm:hidden">
        {model.secondary.map((entry) => <StoryRow entry={entry} />)}
      </div>
    </section>
  ) : null}

  <ServiceBand />

  <section
    class="mx-auto hidden w-[min(1200px,calc(100%-32px))] py-[30px] pb-1 max-sm:block"
    aria-label="Naujausi straipsniai"
  >
    <SectionHeader title="Naujausi straipsniai" />
    {model.secondary.map((entry) => (
      <StoryRow entry={entry} variant="compact" />
    ))}
  </section>

  <section class="mx-auto grid w-[min(1200px,calc(100%-64px))] grid-cols-[minmax(0,3fr)_minmax(210px,1fr)] gap-[38px] pb-[30px] pt-11 max-lg:grid-cols-1 max-sm:w-[min(1200px,calc(100%-32px))] max-sm:pb-5 max-sm:pt-1" id="articles">
    <div>
      <SectionHeader
        href="/archyvas"
        linkLabel="Visi straipsniai"
        title="Naujausi straipsniai"
      />
      <div class="grid grid-cols-3 gap-[22px] max-sm:grid-cols-1">
        {model.recent.map((entry) => <ArticleCard entry={entry} />)}
      </div>
    </div>
    <ArchivePanel months={model.archiveMonths} />
  </section>

  {model.sectionGroups.map((section) => (
    <section class="mx-auto w-[min(1200px,calc(100%-64px))] py-12 max-sm:w-[min(1200px,calc(100%-32px))]">
      <SectionHeader
        href={section.href}
        linkLabel="Daugiau"
        title={section.title}
      />
      <div class="grid grid-cols-2 gap-x-[38px] gap-y-2 max-sm:grid-cols-1">
        {section.articles.map((entry) => (
          <StoryRow entry={entry} variant="section" />
        ))}
      </div>
    </section>
  ))}

  <LibraryCallout
    description={model.library.description}
    title={model.library.title}
  />
</main>
