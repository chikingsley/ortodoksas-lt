---
interface Props {
  description: string;
  title: string;
}

const { description, title } = Astro.props;
---

<section class="site-width library-callout">
  <div>
    <h2>{title}</h2>
    <p>{description}</p>
    <a class="text-link" href="/p/biblioteka.html">
      Atverti biblioteką <span aria-hidden="true">→</span>
    </a>
  </div>
  <img
    src="/assets/brand/production/canva-patterns/pattern-gold-grid.png"
    alt=""
  />
</section>
