---
const serviceLinks = [
  {
    detail: "Tvarkaraščiai ir bendruomenės",
    href: "/p/bendruomenes_21.html",
    icon: "church",
    title: "Pamaldos",
  },
  {
    detail: "Šventės ir pasninkai",
    href: "/p/kalendorius.html",
    icon: "calendar",
    title: "Kalendorius",
  },
  {
    detail: "Straipsniai ir knygos",
    href: "/p/biblioteka.html",
    icon: "book",
    title: "Biblioteka",
  },
  {
    detail: "Prisidėkite prie misijos",
    href: "/p/paremti.html",
    icon: "heart",
    title: "Paremti",
  },
] as const;
const motifPositions = [
  "left-1/4 -translate-x-1/2 max-sm:hidden",
  "left-1/2 -translate-x-1/2",
  "left-3/4 -translate-x-1/2 max-sm:hidden",
  "right-0",
] as const;
---

<section class="bg-primary text-white" aria-label="Praktinė informacija">
  <div class="relative mx-auto grid w-[min(1200px,calc(100%-64px))] grid-cols-4 max-lg:grid-cols-2 max-sm:w-full">
    {serviceLinks.map((service) => (
      <a class="relative grid min-h-[66px] grid-cols-[36px_1fr] items-center gap-2 overflow-hidden px-4 py-[11px] transition-colors hover:bg-brand-dark max-sm:px-4 max-sm:py-2 max-sm:pr-6" href={service.href}>
        <svg class="size-9 fill-none stroke-gold stroke-[1.5] [stroke-linecap:round] [stroke-linejoin:round]" aria-hidden="true" viewBox="0 0 32 32">
          {service.icon === "church" ? (
            <>
              <path d="M16 3v7M12.5 6.5h7M8 27h16M10 27V14l6-4 6 4v13M14 27v-7h4v7" />
            </>
          ) : null}
          {service.icon === "calendar" ? (
            <>
              <rect x="6" y="8" width="20" height="18" rx="1" />
              <path d="M10 5v6M22 5v6M6 13h20M11 18h3M18 18h3M11 22h3M18 22h3" />
            </>
          ) : null}
          {service.icon === "book" ? (
            <>
              <path d="M5 7h8a3 3 0 0 1 3 3v17a4 4 0 0 0-4-4H5zM27 7h-8a3 3 0 0 0-3 3v17a4 4 0 0 1 4-4h7z" />
            </>
          ) : null}
          {service.icon === "heart" ? (
            <path d="M16 27S6 21 6 13.5A5.5 5.5 0 0 1 16 10a5.5 5.5 0 0 1 10 3.5C26 21 16 27 16 27Z" />
          ) : null}
        </svg>
        <span>
          <strong class="block font-serif text-base font-bold leading-[1.2]">{service.title}</strong>
          <small class="mt-1 block text-[11px] leading-[1.3] text-white/85 max-sm:max-w-[15ch]">{service.detail}</small>
        </span>
      </a>
    ))}
    {motifPositions.map((position) => (
      <span
        class={`pointer-events-none absolute inset-y-0 z-[2] w-[18px] bg-[url('/assets/brand/production/canva-patterns/motif-gold-chain.png')] bg-[length:18px_auto] bg-repeat-y ${position}`}
        aria-hidden="true"
      />
    ))}
  </div>
</section>
