---
import { formatDate, type CatalogEntry } from "../../lib/publication";
import EditorialImage from "../media/EditorialImage.astro";

interface Props {
  entry: CatalogEntry;
  featured?: boolean;
}

const { entry, featured = false } = Astro.props;
---

<article class:list={["group max-sm:grid max-sm:grid-cols-[116px_1fr] max-sm:gap-3.5 max-sm:border-b max-sm:border-border max-sm:py-3.5", { "grid grid-cols-[1.3fr_1fr] gap-7": featured }]}>
  {entry.hero ? <EditorialImage class={featured ? "block aspect-[1.4] overflow-hidden bg-muted [&_img]:h-full [&_img]:w-full [&_img]:object-cover [&_img]:transition-transform [&_img]:duration-500 group-hover:[&_img]:scale-[1.02]" : "block aspect-[1.48] overflow-hidden bg-muted max-sm:aspect-[1.3] [&_img]:h-full [&_img]:w-full [&_img]:object-cover [&_img]:transition-transform [&_img]:duration-500 group-hover:[&_img]:scale-[1.02]"} href={entry.path} label={`Atverti: ${entry.title}`} src={entry.hero} /> : null}
  <div class="pt-3.5 max-sm:pt-0">
    <div class="text-[10px] font-bold uppercase tracking-[0.08em] text-primary">{entry.section}</div>
    <h2 class:list={["mb-3 mt-[7px] font-serif font-bold leading-[1.12] tracking-[-0.012em]", featured ? "text-[30px]" : "text-xl max-sm:text-[17px]"]}><a class="hover:text-primary" href={entry.path}>{entry.title}</a></h2>
    {featured ? <p class="font-serif text-base leading-normal text-muted-foreground">{entry.description}</p> : null}
    <div class="flex items-center gap-2 text-[9px] font-bold uppercase tracking-[0.05em] text-muted-foreground max-sm:[&_span:nth-last-child(-n+2)]:hidden">
      {entry.published ? <time datetime={entry.published}>{formatDate(entry.published)}</time> : null}
      <span aria-hidden="true">·</span>
      <span>Skaityti</span>
    </div>
  </div>
</article>
