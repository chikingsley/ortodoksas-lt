---
import { formatDate, type CatalogEntry } from "./publication";
import { getSectionLabel } from "@ortodoksas-lt/content/sections";
import type { SiteLocale } from "../../i18n/config";
import { ui } from "../../i18n/ui";
import EditorialImage from "./EditorialImage.astro";

interface Props {
  entry: CatalogEntry;
  featured?: boolean;
  loading?: "eager" | "lazy";
  locale?: SiteLocale;
}

const { entry, featured = false, loading = "lazy", locale = "lt" } = Astro.props;
const href = locale === "lt" ? entry.path : `/${locale}${entry.path}`;
const copy = ui[locale];
const imageFit = entry.heroFit === "contain" ? "[&_img]:object-contain [&_img]:p-2" : "[&_img]:object-cover";
const objectPosition = `${entry.heroFocalX}% ${entry.heroFocalY}%`;
---

<article class:list={["group flex h-full flex-col max-sm:grid max-sm:h-auto max-sm:grid-cols-[116px_1fr] max-sm:gap-4 max-sm:border-t max-sm:border-border max-sm:py-4 max-sm:first:border-t-0 max-sm:first:pt-0", { "grid grid-cols-[1.3fr_1fr] gap-6": featured }]}>
  {entry.hero ? <EditorialImage alt={entry.heroAlt} class:list={[featured ? "block aspect-[1.4] overflow-hidden bg-muted [&_img]:h-full [&_img]:w-full [&_img]:transition-transform [&_img]:duration-500 group-hover:[&_img]:scale-[1.02]" : "block aspect-[1.48] overflow-hidden bg-muted max-sm:aspect-[1.3] [&_img]:h-full [&_img]:w-full [&_img]:transition-transform [&_img]:duration-500 group-hover:[&_img]:scale-[1.02]", imageFit]} href={href} label={`${copy.read}: ${entry.title}`} loading={loading} objectPosition={objectPosition} src={entry.hero} unavailableLabel={copy.imageUnavailable} /> : null}
  <div class="flex flex-1 flex-col pt-4 max-sm:pt-0">
    <div class="text-[10px] font-bold uppercase tracking-[0.08em] text-primary">{getSectionLabel(entry.section, locale)}</div>
    <h2 class:list={["mb-2 mt-2 font-serif font-bold leading-[1.12] tracking-[-0.012em]", featured ? "text-[30px]" : "text-xl max-sm:text-[17px]"]}><a class="hover:text-primary" href={href}>{entry.title}</a></h2>
    {entry.description ? <p class:list={["m-0 line-clamp-2 font-serif leading-[1.4] text-muted-foreground", featured ? "text-base" : "text-sm max-sm:text-[13px]"]}>{entry.description}</p> : null}
    <div class="mt-auto flex items-center gap-2 pt-3 text-[9px] font-bold uppercase tracking-[0.05em] text-muted-foreground max-sm:pt-2 max-sm:[&_span:nth-last-child(-n+2)]:hidden">
      {entry.published ? <time datetime={entry.published}>{formatDate(entry.published, locale)}</time> : null}
      <span aria-hidden="true">·</span>
      <span>{copy.read}</span>
    </div>
  </div>
</article>
