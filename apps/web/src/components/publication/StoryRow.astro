---
import { formatDate, type CatalogEntry } from "../../lib/publication";
import EditorialImage from "../media/EditorialImage.astro";

interface Props {
  entry: CatalogEntry;
  locale?: Parameters<typeof formatDate>[1];
  variant?: "compact" | "section" | "supporting";
}

const { entry, locale = "lt", variant = "supporting" } = Astro.props;
---

{variant === "supporting" ? (
  <article class="group grid grid-cols-[46%_1fr] gap-[18px] border-border border-t py-3.5 first:border-t-0 first:pt-0 max-lg:block max-lg:border-0 max-lg:pt-0 max-sm:grid max-sm:grid-cols-[116px_1fr] max-sm:gap-3.5 max-sm:border-t max-sm:border-border max-sm:py-3.5 max-sm:first:border-t-0">
    {entry.hero ? <EditorialImage alt={entry.heroAlt} class="block aspect-[1.55] overflow-hidden bg-muted max-lg:mb-3 max-sm:m-0 max-sm:aspect-[1.35] [&_img]:h-full [&_img]:w-full [&_img]:object-cover [&_img]:transition-transform [&_img]:duration-500 group-hover:[&_img]:scale-[1.02]" href={entry.path} label={`Atverti: ${entry.title}`} loading="eager" src={entry.hero} /> : null}
    <div>
      <div class="text-[10px] font-bold uppercase tracking-[0.08em] text-primary">{entry.section}</div>
      <h2 class="mb-2 mt-[5px] font-serif text-[clamp(17px,1.55vw,22px)] font-bold leading-[1.08] tracking-[-0.015em] max-lg:text-lg max-sm:mb-0 max-sm:text-base"><a class="line-clamp-3 hover:text-primary max-sm:line-clamp-4" href={entry.path}>{entry.title}</a></h2>
      <p class="mb-[9px] line-clamp-2 font-serif text-[13px] leading-[1.4] text-muted-foreground max-sm:hidden">{entry.description}</p>
      {entry.published ? <div class="mt-2 text-[9px] font-bold uppercase tracking-[0.05em] text-muted-foreground"><time datetime={entry.published}>{formatDate(entry.published, locale)}</time></div> : null}
      <a class="inline-flex items-center gap-[7px] text-[11px] font-bold text-primary max-sm:hidden" href={entry.path}>Skaityti <span aria-hidden="true">→</span></a>
    </div>
  </article>
) : variant === "compact" ? (
  <article class="grid grid-cols-[102px_1fr] gap-3 border-border border-t py-3 first:border-t-0 first:pt-0">
    {entry.hero ? <EditorialImage alt={entry.heroAlt} class="block aspect-[1.35] overflow-hidden bg-muted [&_img]:h-full [&_img]:w-full [&_img]:object-cover" href={entry.path} label={`Atverti: ${entry.title}`} loading="eager" src={entry.hero} /> : null}
    <div><div class="text-[10px] font-bold uppercase tracking-[0.08em] text-primary">{entry.section}</div><h2 class="mb-0 mt-[5px] font-serif text-[15px] font-bold leading-[1.1]"><a class="hover:text-primary" href={entry.path}>{entry.title}</a></h2>{entry.published ? <div class="mt-2 text-[9px] font-bold uppercase tracking-[0.05em] text-muted-foreground"><time datetime={entry.published}>{formatDate(entry.published, locale)}</time></div> : null}</div>
  </article>
) : (
  <article class="grid grid-cols-[132px_1fr] gap-[18px] py-[18px] first:pt-0 max-sm:grid-cols-[108px_1fr]">
    {entry.hero ? <EditorialImage alt={entry.heroAlt} class="block aspect-[1.25] overflow-hidden bg-muted [&_img]:h-full [&_img]:w-full [&_img]:object-cover" href={entry.path} label={`Atverti: ${entry.title}`} src={entry.hero} /> : null}
    <div>
      <div class="text-[10px] font-bold uppercase tracking-[0.08em] text-primary">{entry.section}</div>
      <h3 class="mb-[7px] mt-[5px] font-serif text-xl font-bold leading-[1.1]"><a class="hover:text-primary" href={entry.path}>{entry.title}</a></h3>
      <time class="text-[9px] uppercase text-muted-foreground" datetime={entry.published ?? undefined}>{formatDate(entry.published, locale)}</time>
      <p class="m-0 line-clamp-2 font-serif text-sm leading-[1.45] text-muted-foreground max-sm:hidden">{entry.description}</p>
    </div>
  </article>
)}
