---
import { formatDate } from './publication';
import type { CatalogEntry } from './publication';
import { getSectionLabel } from "@ortodoksas-lt/content/sections";
import type { SiteLocale } from "../../i18n/config";
import { ui } from "../../i18n/ui";
import EditorialImage from "./EditorialImage.astro";

interface Props {
  entry: CatalogEntry;
  locale?: SiteLocale;
}

const { entry, locale = "lt" } = Astro.props;
const href = locale === "lt" ? entry.path : `/${locale}${entry.path}`;
const copy = ui[locale];
const imageFit = entry.heroFit === "contain" ? "[&_img]:mx-auto [&_img]:max-h-[420px] [&_img]:max-w-full [&_img]:h-auto [&_img]:w-auto [&_img]:object-contain" : "aspect-[1.65] [&_img]:h-full [&_img]:w-full [&_img]:object-cover max-sm:aspect-[1.35]";
const objectPosition = `${entry.heroFocalX}% ${entry.heroFocalY}%`;
---

<article class="group">
  {entry.hero ? <EditorialImage alt={entry.heroAlt} class:list={["mb-[17px] block overflow-hidden max-sm:mb-4", imageFit]} href={href} label={`${copy.read}: ${entry.title}`} objectPosition={objectPosition} priority src={entry.hero} unavailableLabel={copy.imageUnavailable} /> : null}
  <div class="text-[10px] font-bold uppercase tracking-[0.08em] text-primary max-sm:mx-3.5">{getSectionLabel(entry.section, locale)}</div>
  <h1 class="mb-[11px] mt-1.5 max-w-[28ch] font-serif text-[clamp(30px,3vw,36px)] font-semibold leading-[1.18] tracking-[-0.028em] max-sm:mx-3.5 max-sm:max-w-none max-sm:text-[clamp(29px,8vw,39px)]"><a class="hover:text-primary" href={href}>{entry.title}</a></h1>
  <p class="mb-3.5 max-w-[70ch] font-serif text-base leading-[1.6] text-muted-foreground max-sm:mx-3.5 max-sm:text-[15px]">{entry.description}</p>
  {entry.published ? <div class="mt-2 text-[9px] font-bold uppercase tracking-[0.05em] text-muted-foreground max-sm:mx-3.5"><time datetime={entry.published}>{formatDate(entry.published, locale)}</time></div> : null}
  <a class="inline-flex items-center gap-[7px] text-[11px] font-bold text-primary max-sm:mx-3.5" href={href}>{copy.readMore} <span aria-hidden="true">→</span></a>
</article>
