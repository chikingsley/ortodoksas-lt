---
import { getSectionLabel } from "@ortodoksas-lt/content/sections";
import CalendarPage from "../information/CalendarPage.astro";
import ClergyPage from "../information/ClergyPage.astro";
import CommunitiesPage from "../information/CommunitiesPage.astro";
import ContactPage from "../information/ContactPage.astro";
import LibraryPage from "../information/LibraryPage.astro";
import SupportPage from "../information/SupportPage.astro";
import SiteLayout from "../layout/SiteLayout.astro";
import ArticleBody from "./ArticleBody.astro";
import EditorialImage from "./EditorialImage.astro";
import { formatDate } from "./publication";
import type { PublicationPageModel } from "./publication-page-model";

interface Props {
  model: PublicationPageModel;
}

const {
  articleSchema,
  bodyHtml,
  bodyOwnsLeadImage,
  canonicalPath,
  copy,
  customBody,
  description,
  displayTitle,
  informationPage,
  locale,
  localized,
  original,
  page,
  translationDisclosure,
  translationState,
  wideBody,
} = Astro.props.model;
const heroFit =
  page.heroFit === "contain"
    ? "[&_img]:object-contain [&_img]:p-3"
    : "[&_img]:object-cover";
const heroObjectPosition = `${page.heroFocalX}% ${page.heroFocalY}%`;
---

<SiteLayout
  title={`${displayTitle} · ${localized ? copy.edition : "ortodoksas.lt"}`}
  description={description}
  canonicalPath={canonicalPath}
  image={page.hero}
  jsonLd={articleSchema}
  lang={locale}
  locale={locale}
  type={page.kind === "article" ? "article" : "website"}
>
  <main>
    <article class:list={["mx-auto mb-[70px] mt-7 max-sm:mt-5", wideBody ? "w-[min(1000px,calc(100%-48px))] max-sm:w-[min(1000px,calc(100%-28px))]" : "w-[min(790px,calc(100%-48px))] max-sm:w-[min(790px,calc(100%-28px))]"]}>
      <header class="text-center">
        {page.kind === "article" ? <div class="text-[10px] font-bold uppercase tracking-[0.08em] text-primary">{getSectionLabel(page.section, locale)}</div> : null}
        <h1 class:list={["mx-auto mb-5 text-balance font-serif text-[clamp(40px,6vw,68px)] font-bold leading-[0.99] tracking-[-0.03em] [overflow-wrap:anywhere] max-sm:text-[clamp(35px,11vw,50px)]", page.kind === "article" ? "mt-3" : "mt-0"]}>{displayTitle}</h1>
        {page.published ? <div class="flex justify-center gap-[18px] text-[10px] uppercase tracking-[0.06em] text-muted-foreground max-sm:flex-col max-sm:gap-[7px]"><time datetime={page.published}>{formatDate(page.published, locale)}</time></div> : null}
        {localized && original && translationState !== "original" ? (
          <p class="mb-7 mt-3 flex justify-center gap-1.5 text-xs leading-[1.4] text-muted-foreground">
            {translationDisclosure}
            <a class="font-bold text-primary" href={original.path}>{copy.viewOriginal}</a>
          </p>
        ) : null}
        {page.hero && !bodyOwnsLeadImage && !customBody ? <EditorialImage alt={page.heroAlt} class:list={["mx-[50%] mb-[46px] mt-[38px] block aspect-[1.72] w-[min(1080px,calc(100vw-48px))] -translate-x-1/2 overflow-hidden bg-muted max-sm:-mx-3.5 max-sm:mb-[34px] max-sm:mt-7 max-sm:w-[calc(100%+28px)] max-sm:translate-x-0 [&_img]:h-full [&_img]:w-full", heroFit]} objectPosition={heroObjectPosition} priority src={page.hero} unavailableLabel={copy.imageUnavailable} /> : null}
      </header>
      {customBody && informationPage === "library" ? <LibraryPage hero={page.hero} heroAlt={page.heroAlt} /> : null}
      {customBody && informationPage === "contact" ? <ContactPage /> : null}
      {customBody && informationPage === "support" ? <SupportPage /> : null}
      {customBody && informationPage === "calendar" ? <CalendarPage /> : null}
      {customBody && informationPage === "communities" ? <CommunitiesPage /> : null}
      {customBody && informationPage === "clergy" ? <ClergyPage hero={page.hero} heroAlt={page.heroAlt || page.title} html={bodyHtml} /> : null}
      {customBody ? null : <ArticleBody html={bodyHtml} />}
      {page.labels.length > 0 ? <footer class="mt-11 flex flex-wrap gap-2 border-t border-border pt-6">{page.labels.map((label) => <span class="rounded-full border border-border px-[11px] py-[7px] text-[10px] text-muted-foreground">{label}</span>)}</footer> : null}
    </article>
  </main>
</SiteLayout>
