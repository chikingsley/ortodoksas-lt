---
import { getSectionLabel } from "@ortodoksas-lt/content/sections";
import ClergyPage from "../information/ClergyPage.astro";
import CommunitiesPage from "../information/CommunitiesPage.astro";
import SiteLayout from "../layout/SiteLayout.astro";
import ArticleBody from "./ArticleBody.astro";
import EditorialImage from "./EditorialImage.astro";
import { formatDate } from "./publication";
import type { PublicationPageModel } from "./publication-page-model";

interface Props {
  model: PublicationPageModel;
}

const {
  articleSchema,
  bodyHtml,
  bodyOwnsLeadImage,
  canonicalPath,
  copy,
  directoryData,
  description,
  displayTitle,
  locale,
  page,
  searchTitle,
  structuredTemplate,
  wideBody,
} = Astro.props.model;

---

<SiteLayout
  title={`${searchTitle} · ortodoksas.lt`}
  description={description}
  canonicalPath={canonicalPath}
  image={page.hero}
  jsonLd={articleSchema}
  lang={locale}
  locale={locale}
  type={page.kind === "article" ? "article" : "website"}
>
  <main>
    <article class:list={["mx-auto mb-[70px] mt-7 max-sm:mt-5", wideBody ? "w-[min(1000px,calc(100%-48px))] max-sm:w-[min(1000px,calc(100%-28px))]" : "w-[min(790px,calc(100%-48px))] max-sm:w-[min(790px,calc(100%-28px))]"]}>
      <header class="text-center">
        {page.kind === "article" ? <div class="text-[10px] font-bold uppercase tracking-[0.08em] text-primary">{getSectionLabel(page.section, locale)}</div> : null}
        <h1 class:list={["mx-auto mb-5 text-balance font-serif text-[clamp(32px,3.4vw,44px)] font-semibold leading-[1.2] tracking-[-0.015em] [overflow-wrap:anywhere] max-sm:text-[32px]", page.kind === "article" ? "mt-3" : "mt-0"]}>{displayTitle}</h1>
        {page.published || page.byline ? <div class="flex justify-center gap-[18px] text-[10px] tracking-[0.06em] text-muted-foreground max-sm:flex-col max-sm:gap-[7px]">{page.published ? <time class="uppercase" datetime={page.published}>{formatDate(page.published, locale)}</time> : null}{page.byline ? page.bylineUrl ? <a class="font-semibold text-foreground hover:text-primary" href={page.bylineUrl}>{page.byline}</a> : <span class="font-semibold text-foreground">{page.byline}</span> : null}</div> : null}
        {page.hero && !bodyOwnsLeadImage && !structuredTemplate ? <EditorialImage alt={page.heroAlt} class="mx-[50%] mb-[46px] mt-[38px] block w-[min(1080px,calc(100vw-48px))] -translate-x-1/2 max-sm:mb-[34px] max-sm:mt-7 [&_img]:mx-auto [&_img]:block [&_img]:h-auto [&_img]:max-h-[720px] [&_img]:w-auto [&_img]:max-w-full [&_img]:object-contain" priority src={page.hero} unavailableLabel={copy.imageUnavailable} /> : null}
      </header>
      {structuredTemplate && bodyHtml ? <ArticleBody html={bodyHtml} /> : null}
      {directoryData?.kind === "communities" ? <CommunitiesPage communities={directoryData.communities} locale={locale} /> : null}
      {directoryData?.kind === "people" ? <ClergyPage hero={page.hero} heroAlt={page.heroAlt || page.title} locale={locale} people={directoryData.people} /> : null}
      {structuredTemplate ? null : <ArticleBody html={bodyHtml} />}
      {page.labels.length > 0 ? <footer class="mt-11 flex flex-wrap gap-2 border-t border-border pt-6">{page.labels.map((label) => <span class="rounded-full border border-border px-[11px] py-[7px] text-[10px] text-muted-foreground">{label}</span>)}</footer> : null}
    </article>
  </main>
</SiteLayout>
