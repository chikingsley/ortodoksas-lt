---
interface Props {
  class?: string;
  label?: string;
}

const {
  class: className,
  label = "Visuotinio Patriarchato Egzarchatas Lietuvoje",
} = Astro.props;
---

<span
  class:list={["institutional-lockup", className]}
  role="img"
  aria-label={label}
>
  <img
    class="institutional-lockup__crest"
    src="/assets/brand/production/exarchate-crest-client.png"
    alt=""
    width="387"
    height="408"
  />
  <span class="institutional-lockup__wordmark" aria-hidden="true">
    <span>VISUOTINIO</span>
    <span>PATRIARCHATO</span>
    <span>EGZARCHATAS</span>
    <span>LIETUVOJE</span>
  </span>
</span>

<style>
  .institutional-lockup {
    display: grid;
    grid-template-columns: 36.86% 59.62%;
    gap: 3.52%;
    align-items: center;
    width: min(100%, var(--institutional-lockup-width, 184px));
    color: var(--institutional-lockup-color, #015c4b);
  }

  .institutional-lockup__crest {
    width: 100%;
    height: auto;
  }

  .institutional-lockup__wordmark {
    display: grid;
    font-family: "Arimo", Arial, sans-serif;
    font-size: calc(var(--institutional-lockup-width, 184px) * 0.0776);
    font-weight: 700;
    line-height: 1.19;
    letter-spacing: 0;
    white-space: nowrap;
    -webkit-text-stroke: 0.012em currentcolor;
  }
</style>
