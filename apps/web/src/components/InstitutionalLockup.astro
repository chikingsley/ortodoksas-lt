---
interface Props {
  class?: string;
  label?: string;
}

const {
  class: className,
  label = "Visuotinio Patriarchato Egzarchatas Lietuvoje",
} = Astro.props;
---

<img
  class:list={["institutional-lockup", className]}
  src="/assets/brand/production/exarchate-lockup-client.png"
  alt={label}
  width="807"
  height="301"
/>

<style>
  .institutional-lockup {
    display: block;
    width: min(100%, var(--institutional-lockup-width, 184px));
    height: auto;
    object-fit: contain;
  }
</style>
