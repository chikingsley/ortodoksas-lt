---
import { supportActions } from "../../content/information";
---

<div class="mt-9">
  <p class="mx-auto mb-9 max-w-[66ch] text-center font-serif text-xl leading-[1.65] text-[#2d312e] max-sm:text-lg">
    <strong>ortodoksas.lt</strong> yra ne pelno siekiančios organizacijos „Krikščionių ortodoksų iniciatyvų centras“, kurią įsteigė Konstantinopolio patriarchato kunigai, dalis.
  </p>
  <div class="grid grid-cols-2 gap-5 max-sm:grid-cols-1">
    {supportActions.map((action) => (
      <a class="group flex min-h-28 items-center justify-between gap-5 border border-primary bg-primary px-6 py-5 text-primary-foreground transition-colors hover:bg-[#7d2d2e]" href={action.href} rel="noreferrer" target="_blank">
        <span>
          <span class="mb-1 block text-[10px] font-bold uppercase tracking-[0.11em] opacity-75">{action.service}</span>
          <span class="font-serif text-2xl leading-tight">{action.label}</span>
        </span>
        <span aria-hidden="true" class="shrink-0 text-xl transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5">↗</span>
      </a>
    ))}
  </div>
  <section class="mt-5 border border-border bg-muted/35 p-7 max-sm:p-5" aria-labelledby="bank-transfer-title">
    <h2 id="bank-transfer-title" class="mb-5 font-serif text-[27px] leading-tight">Banko pavedimas</h2>
    <dl class="grid grid-cols-[auto_1fr] gap-x-7 gap-y-3 text-sm max-sm:grid-cols-1 max-sm:gap-y-1">
      <dt class="font-bold text-muted-foreground">Gavėjas</dt>
      <dd class="max-sm:mb-3">VšĮ „Krikščionių ortodoksų iniciatyvų centras“</dd>
      <dt class="font-bold text-muted-foreground">IBAN</dt>
      <dd class="font-mono tracking-[0.02em] max-sm:mb-3">LT487300010173170576</dd>
      <dt class="font-bold text-muted-foreground">SWIFT</dt>
      <dd class="font-mono tracking-[0.02em]">HABALT22</dd>
    </dl>
  </section>
  <p class="mt-7 text-center font-serif text-xl italic">Nuoširdžiai dėkojame už paramą!</p>
</div>
