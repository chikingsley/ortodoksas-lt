---
import { calendarLinks } from "../../content/information";
---

<div class="mt-9 grid grid-cols-2 gap-5 max-sm:grid-cols-1">
  {calendarLinks.map((link) => (
    <a class="group flex min-h-40 flex-col justify-between border border-border p-7 transition-colors hover:border-primary max-sm:min-h-32 max-sm:p-5" href={link.href} rel={link.href.startsWith("http") ? "noreferrer" : undefined} target={link.href.startsWith("http") ? "_blank" : undefined}>
      <span aria-hidden="true" class="self-end font-sans text-primary transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5">{link.href.startsWith("http") ? "↗" : "→"}</span>
      <span>
        <span class="mb-2 block font-serif text-[27px] leading-tight">{link.label}</span>
        <span class="block text-sm leading-relaxed text-muted-foreground">{link.description}</span>
      </span>
    </a>
  ))}
</div>
