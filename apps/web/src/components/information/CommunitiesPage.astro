---
import type { SiteLocale } from "../../i18n/config";

interface CommunityRecord {
  accessibility: string;
  addressLabel: string;
  contacts: { href: string; label: string }[];
  description: string;
  id: string;
  media: { altText: string; mediaId: string; role: string }[];
  name: string;
  operationalNotice: string;
  operationalStatus: string;
  services: { scheduleText: string }[];
  slug: string;
}

interface Props {
  communities?: CommunityRecord[];
  detail?: boolean;
  locale: SiteLocale;
}

const { communities = [], detail = false, locale } = Astro.props;
const labels = {
  be: { accessibility: "Даступнасць", address: "Адрас", contacts: "Кантакты", gallery: "Фотагалерэя", next: "Наступнае фота", previous: "Папярэдняе фота", services: "Набажэнствы" },
  en: { accessibility: "Accessibility", address: "Address", contacts: "Contacts", gallery: "Photo gallery", next: "Next photo", previous: "Previous photo", services: "Services" },
  lt: { accessibility: "Prieinamumas", address: "Adresas", contacts: "Kontaktai", gallery: "Nuotraukų galerija", next: "Kita nuotrauka", previous: "Ankstesnė nuotrauka", services: "Pamaldos" },
  ru: { accessibility: "Доступность", address: "Адрес", contacts: "Контакты", gallery: "Фотогалерея", next: "Следующее фото", previous: "Предыдущее фото", services: "Богослужения" },
  uk: { accessibility: "Доступність", address: "Адреса", contacts: "Контакти", gallery: "Світлини", next: "Наступне фото", previous: "Попереднє фото", services: "Богослужіння" },
}[locale];
---

<div class:list={["mt-9 grid items-stretch gap-5", detail ? "grid-cols-1" : "grid-cols-2 max-md:grid-cols-1"]}>
  {communities.map((community) => (
    <section class="worship-community flex min-w-0 flex-col overflow-hidden border border-border">
      {community.media.length > 0 ? (
      <div class="group relative aspect-[1.62] w-full overflow-hidden bg-muted" data-gallery>
        <div aria-label={`${labels.gallery}: ${community.name}`} class="gallery-track flex h-full snap-x snap-mandatory overflow-x-auto scroll-smooth" data-gallery-track role="region" tabindex="0">
          {community.media.map((image, imageIndex) => (
            <figure class="h-full w-full min-w-full snap-center" data-gallery-slide>
              <img class="h-full w-full object-cover" src={`/api/media/${image.mediaId}`} alt={image.altText} loading={imageIndex === 0 ? "eager" : "lazy"} />
            </figure>
          ))}
        </div>
        {community.media.length > 1 ? (
          <div class="pointer-events-none absolute inset-x-0 bottom-0 flex items-center justify-between bg-gradient-to-t from-black/65 to-transparent px-3 pb-3 pt-8 text-white">
            <button aria-label={`${labels.previous}: ${community.name}`} class="pointer-events-auto grid size-8 place-items-center border border-white/55 bg-black/35 text-lg leading-none transition hover:bg-black/60" data-gallery-previous type="button">←</button>
            <span class="rounded-sm bg-black/45 px-2 py-1 font-bold text-[10px] tabular-nums tracking-[0.08em]" data-gallery-counter>1 / {community.media.length}</span>
            <button aria-label={`${labels.next}: ${community.name}`} class="pointer-events-auto grid size-8 place-items-center border border-white/55 bg-black/35 text-lg leading-none transition hover:bg-black/60" data-gallery-next type="button">→</button>
          </div>
        ) : null}
      </div>
      ) : null}
      <div class="flex flex-1 flex-col p-7 max-sm:p-5">
        {detail ? null : (
          <h2 class="mb-5 text-balance font-serif text-[29px] leading-[1.08] tracking-[-0.015em] [overflow-wrap:anywhere] max-sm:text-[26px]">
            <a class="transition-colors hover:text-primary" href={`${locale === "lt" ? "" : `/${locale}`}/community/${community.slug}`}>{community.name}</a>
          </h2>
        )}
        {community.description ? <p class="mb-5 text-sm leading-relaxed text-muted-foreground">{community.description}</p> : null}
        {community.operationalNotice ? (
          <p class="mb-5 border-primary border-l-2 pl-4 text-sm leading-relaxed">
            {community.operationalNotice}
          </p>
        ) : null}
        <dl class="grid gap-0 border-border border-t text-sm leading-relaxed">
          <div class="grid grid-cols-[92px_minmax(0,1fr)] gap-4 border-border border-b py-3.5 max-sm:grid-cols-1 max-sm:gap-1">
            <dt class="text-[10px] font-bold uppercase tracking-[0.09em] text-primary">{labels.address}</dt>
            <dd class="[overflow-wrap:anywhere]">{community.addressLabel}</dd>
          </div>
          {detail && community.accessibility ? (
            <div class="grid grid-cols-[92px_minmax(0,1fr)] gap-4 border-border border-b py-3.5 max-sm:grid-cols-1 max-sm:gap-1">
              <dt class="text-[10px] font-bold uppercase tracking-[0.09em] text-primary">{labels.accessibility}</dt>
              <dd class="whitespace-pre-line [overflow-wrap:anywhere]">{community.accessibility}</dd>
            </div>
          ) : null}
          <div class="grid grid-cols-[92px_minmax(0,1fr)] gap-4 border-border border-b py-3.5 max-sm:grid-cols-1 max-sm:gap-1">
            <dt class="text-[10px] font-bold uppercase tracking-[0.09em] text-primary">{labels.services}</dt>
            <dd>
              <ul class="grid gap-2">
                {community.services.map((service) => <li class="[overflow-wrap:anywhere]">{service.scheduleText}</li>)}
              </ul>
            </dd>
          </div>
          <div class="grid grid-cols-[92px_minmax(0,1fr)] gap-4 py-3.5 max-sm:grid-cols-1 max-sm:gap-1">
            <dt class="text-[10px] font-bold uppercase tracking-[0.09em] text-primary">{labels.contacts}</dt>
            <dd class="flex flex-wrap gap-x-4 gap-y-2">
              {community.contacts.map((link) => (
                <a class="font-bold text-primary underline decoration-primary/35 underline-offset-[3px] hover:decoration-primary" href={link.href} rel={link.href.startsWith("http") ? "noreferrer" : undefined} target={link.href.startsWith("http") ? "_blank" : undefined}>{link.label}</a>
              ))}
            </dd>
          </div>
        </dl>
      </div>
    </section>
  ))}
</div>


<script>
  const galleries = document.querySelectorAll<HTMLElement>("[data-gallery]");

  for (const gallery of galleries) {
    const track = gallery.querySelector<HTMLElement>("[data-gallery-track]");
    const slides = gallery.querySelectorAll<HTMLElement>("[data-gallery-slide]");
    const counter = gallery.querySelector<HTMLElement>("[data-gallery-counter]");
    const previous = gallery.querySelector<HTMLButtonElement>("[data-gallery-previous]");
    const next = gallery.querySelector<HTMLButtonElement>("[data-gallery-next]");

    if (!(track && counter && previous && next && slides.length > 1)) {
      continue;
    }

    const updateCounter = () => {
      const index = Math.min(
        slides.length - 1,
        Math.max(0, Math.round(track.scrollLeft / track.clientWidth))
      );
      counter.textContent = `${index + 1} / ${slides.length}`;
    };

    const move = (direction: -1 | 1) => {
      const index = Math.round(track.scrollLeft / track.clientWidth);
      const target = (index + direction + slides.length) % slides.length;
      track.scrollTo({ behavior: "smooth", left: target * track.clientWidth });
    };

    previous.addEventListener("click", () => move(-1));
    next.addEventListener("click", () => move(1));
    track.addEventListener("scrollend", updateCounter);
    track.addEventListener("scroll", updateCounter, { passive: true });
  }
</script>

<style>
  .gallery-track {
    scrollbar-width: none;
  }

  .gallery-track::-webkit-scrollbar {
    display: none;
  }
</style>
