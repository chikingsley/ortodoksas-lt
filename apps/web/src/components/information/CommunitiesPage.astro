---
import {
  worshipCommunities,
  worshipVerificationNotice,
} from "../../content/communities";
---

<div class="mt-9 grid grid-cols-2 items-stretch gap-5 max-md:grid-cols-1">
  {worshipCommunities.map((community) => (
    <section class="worship-community flex min-w-0 flex-col overflow-hidden border border-border">
      <div class="group relative aspect-[1.62] w-full overflow-hidden bg-muted" data-gallery>
        <div class="gallery-track flex h-full snap-x snap-mandatory overflow-x-auto scroll-smooth" data-gallery-track>
          {community.images.map((image, imageIndex) => (
            <figure class="h-full w-full min-w-full snap-center" data-gallery-slide>
              <img class="h-full w-full object-cover" src={image.src} alt={image.alt} loading={imageIndex === 0 ? "eager" : "lazy"} />
            </figure>
          ))}
        </div>
        {community.images.length > 1 ? (
          <div class="pointer-events-none absolute inset-x-0 bottom-0 flex items-center justify-between bg-gradient-to-t from-black/65 to-transparent px-3 pb-3 pt-8 text-white">
            <button aria-label={`Ankstesnė ${community.name} nuotrauka`} class="pointer-events-auto grid size-8 place-items-center border border-white/55 bg-black/35 text-lg leading-none transition hover:bg-black/60" data-gallery-previous type="button">←</button>
            <span class="rounded-sm bg-black/45 px-2 py-1 font-bold text-[10px] tabular-nums tracking-[0.08em]" data-gallery-counter>1 / {community.images.length}</span>
            <button aria-label={`Kita ${community.name} nuotrauka`} class="pointer-events-auto grid size-8 place-items-center border border-white/55 bg-black/35 text-lg leading-none transition hover:bg-black/60" data-gallery-next type="button">→</button>
          </div>
        ) : null}
      </div>
      <div class="flex flex-1 flex-col p-7 max-sm:p-5">
        <h2 class="mb-5 text-balance font-serif text-[29px] leading-[1.08] tracking-[-0.015em] [overflow-wrap:anywhere] max-sm:text-[26px]">
          {community.name}
        </h2>
        <dl class="grid gap-0 border-border border-t text-sm leading-relaxed">
          <div class="grid grid-cols-[92px_minmax(0,1fr)] gap-4 border-border border-b py-3.5 max-sm:grid-cols-1 max-sm:gap-1">
            <dt class="text-[10px] font-bold uppercase tracking-[0.09em] text-primary">Adresas</dt>
            <dd class="[overflow-wrap:anywhere]">{community.address}</dd>
          </div>
          <div class="grid grid-cols-[92px_minmax(0,1fr)] gap-4 border-border border-b py-3.5 max-sm:grid-cols-1 max-sm:gap-1">
            <dt class="text-[10px] font-bold uppercase tracking-[0.09em] text-primary">Pamaldos</dt>
            <dd>
              <ul class="grid gap-2">
                {community.services.map((service) => <li class="[overflow-wrap:anywhere]">{service}</li>)}
              </ul>
            </dd>
          </div>
          <div class="grid grid-cols-[92px_minmax(0,1fr)] gap-4 py-3.5 max-sm:grid-cols-1 max-sm:gap-1">
            <dt class="text-[10px] font-bold uppercase tracking-[0.09em] text-primary">Kontaktai</dt>
            <dd class="flex flex-wrap gap-x-4 gap-y-2">
              {community.contacts.map((link) => (
                <a class="font-bold text-primary underline decoration-primary/35 underline-offset-[3px] hover:decoration-primary" href={link.href} rel={link.href.startsWith("http") ? "noreferrer" : undefined} target={link.href.startsWith("http") ? "_blank" : undefined}>{link.label}</a>
              ))}
            </dd>
          </div>
        </dl>
      </div>
    </section>
  ))}
</div>

<aside class="mt-8 grid grid-cols-[140px_minmax(0,1fr)] gap-6 border-primary border-t-2 py-6 max-sm:grid-cols-1 max-sm:gap-2" aria-labelledby="worship-verification-title">
  <h2 class="font-serif text-2xl leading-tight" id="worship-verification-title">{worshipVerificationNotice.name}</h2>
  <div class="text-sm leading-relaxed">
    <p>{worshipVerificationNotice.text}</p>
    <a class="mt-2 inline-block font-bold text-primary underline decoration-primary/35 underline-offset-[3px]" href={worshipVerificationNotice.contact.href}>{worshipVerificationNotice.contact.label}</a>
  </div>
</aside>

<script>
  const galleries = document.querySelectorAll<HTMLElement>("[data-gallery]");

  for (const gallery of galleries) {
    const track = gallery.querySelector<HTMLElement>("[data-gallery-track]");
    const slides = gallery.querySelectorAll<HTMLElement>("[data-gallery-slide]");
    const counter = gallery.querySelector<HTMLElement>("[data-gallery-counter]");
    const previous = gallery.querySelector<HTMLButtonElement>("[data-gallery-previous]");
    const next = gallery.querySelector<HTMLButtonElement>("[data-gallery-next]");

    if (!(track && counter && previous && next && slides.length > 1)) {
      continue;
    }

    const updateCounter = () => {
      const index = Math.min(
        slides.length - 1,
        Math.max(0, Math.round(track.scrollLeft / track.clientWidth))
      );
      counter.textContent = `${index + 1} / ${slides.length}`;
    };

    const move = (direction: -1 | 1) => {
      const index = Math.round(track.scrollLeft / track.clientWidth);
      const target = (index + direction + slides.length) % slides.length;
      track.scrollTo({ behavior: "smooth", left: target * track.clientWidth });
    };

    previous.addEventListener("click", () => move(-1));
    next.addEventListener("click", () => move(1));
    track.addEventListener("scrollend", updateCounter);
    track.addEventListener("scroll", updateCounter, { passive: true });
  }
</script>

<style>
  .gallery-track {
    scrollbar-width: none;
  }

  .gallery-track::-webkit-scrollbar {
    display: none;
  }
</style>
