---
import { structureClergyHtml } from "./clergy-html";
import ArticleBody from "../publication/ArticleBody.astro";
import EditorialImage from "../publication/EditorialImage.astro";

interface Props {
  hero: string | null;
  heroAlt: string;
  html: string;
}

const { hero, heroAlt, html } = Astro.props;
const directory = structureClergyHtml(html);
---

<div class="clergy-directory mt-9">
  {hero ? (
    <EditorialImage
      alt={heroAlt}
      class="mx-auto mb-10 block aspect-[1.9] w-full max-w-[900px] overflow-hidden bg-white [&_img]:h-full [&_img]:w-full [&_img]:object-contain"
      priority
      src={hero}
    />
  ) : null}
  {directory.introductionHtml ? (
    <div class="mx-auto mb-10 max-w-[780px]">
      <ArticleBody html={directory.introductionHtml} />
    </div>
  ) : null}
  <div class="grid">
    {directory.profiles.map((profile) => (
      <section class="clergy-profile grid grid-cols-[210px_minmax(0,1fr)] gap-9 border-border border-t py-9 max-sm:grid-cols-1 max-sm:gap-5 max-sm:py-8">
        <div class="clergy-portrait" set:html={profile.figureHtml} />
        <div class="clergy-details min-w-0" set:html={profile.detailsHtml} />
      </section>
    ))}
  </div>
</div>

<style>
  .clergy-portrait :global(figure) {
    margin: 0;
  }

  .clergy-portrait :global(img) {
    aspect-ratio: 1;
    border-radius: 9999px;
    display: block;
    height: 210px;
    margin: 0;
    object-fit: cover;
    width: 210px;
  }

  .clergy-portrait :global(figcaption:empty) {
    display: none;
  }

  .clergy-details :global(.clergy-role) {
    color: var(--color-primary);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.11em;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  .clergy-details :global(.clergy-name) {
    font-family: var(--font-serif);
    font-size: 32px;
    line-height: 1.08;
    margin: 0 0 18px;
    overflow-wrap: anywhere;
  }

  .clergy-details :global(p) {
    color: #2d312e;
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.65;
    margin: 0 0 16px;
    overflow-wrap: anywhere;
  }

  .clergy-details :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-primary) 35%, transparent);
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .clergy-portrait :global(img) {
      height: 168px;
      margin-inline: auto;
      width: 168px;
    }

    .clergy-details :global(.clergy-name) {
      font-size: 28px;
    }

    .clergy-details :global(p) {
      font-size: 17px;
      line-height: 1.6;
    }
  }
</style>
