---
import ArticleBody from "../publication/ArticleBody.astro";
import EditorialImage from "../publication/EditorialImage.astro";

interface Props {
  hero: string | null;
  heroAlt: string;
  people?: {
    biographyHtml: string;
    contacts: { href: string; label: string }[];
    displayName: string;
    id: string;
    media: { altText: string; mediaId: string; role: string }[];
    positions: { title: string }[];
  }[];
}

const { hero, heroAlt, people = [] } = Astro.props;
---

<div class="clergy-directory mt-9">
  {hero ? (
    <EditorialImage
      alt={heroAlt}
      class="mx-auto mb-10 block aspect-[1.9] w-full max-w-[900px] overflow-hidden bg-white [&_img]:h-full [&_img]:w-full [&_img]:object-contain"
      priority
      src={hero}
    />
  ) : null}
  <div class="grid">
    {people.map((person) => {
      const portrait = person.media.find((item) => item.role === "primary");
      return (
      <section class="clergy-profile grid grid-cols-[210px_minmax(0,1fr)] gap-9 border-border border-t py-9 max-sm:grid-cols-1 max-sm:gap-5 max-sm:py-8">
        <div class="clergy-portrait">
          {portrait ? <img alt={portrait.altText} height="210" loading="lazy" src={`/api/media/${portrait.mediaId}`} width="210" /> : null}
        </div>
        <div class="clergy-details min-w-0">
          {person.positions.map((position) => <p class="clergy-role">{position.title}</p>)}
          <h2 class="clergy-name">{person.displayName}</h2>
          <ArticleBody html={person.biographyHtml} />
          {person.contacts.length > 0 ? <div class="mt-4 flex flex-wrap gap-3">{person.contacts.map((contact) => <a href={contact.href}>{contact.label}</a>)}</div> : null}
        </div>
      </section>
      );
    })}
  </div>
</div>

<style>
  .clergy-portrait img {
    aspect-ratio: 1;
    border-radius: 9999px;
    display: block;
    height: 210px;
    margin: 0;
    object-fit: cover;
    width: 210px;
  }

  .clergy-role {
    color: var(--color-primary);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.11em;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  .clergy-name {
    font-family: var(--font-serif);
    font-size: 32px;
    line-height: 1.08;
    margin: 0 0 18px;
    overflow-wrap: anywhere;
  }

  .clergy-details :global(p) {
    color: #2d312e;
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.65;
    margin: 0 0 16px;
    overflow-wrap: anywhere;
  }

  .clergy-details :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-primary) 35%, transparent);
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .clergy-portrait img {
      height: 168px;
      margin-inline: auto;
      width: 168px;
    }

    .clergy-name {
      font-size: 28px;
    }

    .clergy-details :global(p) {
      font-size: 17px;
      line-height: 1.6;
    }
  }
</style>
