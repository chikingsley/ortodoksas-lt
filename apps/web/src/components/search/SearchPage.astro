---
import type { SiteLocale } from "../../i18n/config";
import { ui } from "../../i18n/ui";
import {
  getRecentArticles,
  searchArticles,
} from "../../lib/publication-repository";
import SiteLayout from "../../layouts/SiteLayout.astro";
import ArchiveList from "../archive/ArchiveList.astro";
import PageIntro from "../publication/PageIntro.astro";
import { SearchForm } from "./search-form";

interface Props {
  locale?: SiteLocale;
}

const { locale = "lt" } = Astro.props;
const localized = locale !== "lt";
const searchPath = localized ? `/${locale}/paieska` : "/paieska";
const query = Astro.url.searchParams.get("q")?.trim() ?? "";
const page = Math.max(1, Number.parseInt(Astro.url.searchParams.get("page") ?? "1", 10) || 1);
const pageSize = 20;
const copy = ui[locale];
const result = query
  ? await searchArticles(locale, query, {
      limit: pageSize,
      offset: (page - 1) * pageSize,
    })
  : { entries: [], total: 0 };
const pageCount = Math.max(1, Math.ceil(result.total / pageSize));
const currentPage = Math.min(page, pageCount);
const visibleMatches = currentPage === page
  ? result.entries
  : (await searchArticles(locale, query, {
      limit: pageSize,
      offset: (currentPage - 1) * pageSize,
    })).entries;
const recentArticles = query ? [] : await getRecentArticles(locale, 6);
const pageHref = (target: number) => `${searchPath}?q=${encodeURIComponent(query)}&page=${target}`;
---

<SiteLayout
  canonicalPath={searchPath}
  description={copy.searchDescription}
  lang={locale}
  locale={locale}
  title={`${ui[locale].search} · ortodoksas.lt`}
>
  <main class="mx-auto w-[min(1200px,calc(100%-64px))] pb-[70px] max-sm:w-[min(1200px,calc(100%-32px))]">
    <PageIntro compact description={copy.searchDescription} eyebrow={copy.searchEyebrow} title={copy.searchTitle} />
    <SearchForm action={searchPath} buttonLabel={copy.search} placeholder={copy.searchPlaceholder} query={query} />
    {query ? (
      <section class="pt-9" aria-live="polite">
        <p class="mb-4 text-xs uppercase tracking-[0.06em] text-muted-foreground">
          <strong class="tabular-nums text-primary">{result.total.toLocaleString(locale)}</strong> {copy.searchResults}
        </p>
        {visibleMatches.length ? <ArchiveList entries={visibleMatches} locale={locale} /> : (
          <p class="border-primary border-t-2 py-8 font-serif text-xl text-muted-foreground">{copy.searchDescription}</p>
        )}
        {pageCount > 1 ? (
          <nav class="flex items-center justify-between py-7" aria-label={ui[locale].search}>
            {currentPage > 1 ? <a class="font-bold text-primary" href={pageHref(currentPage - 1)}>←</a> : <span />}
            <span class="text-xs text-muted-foreground">{currentPage} / {pageCount}</span>
            {currentPage < pageCount ? <a class="font-bold text-primary" href={pageHref(currentPage + 1)}>→</a> : <span />}
          </nav>
        ) : null}
      </section>
    ) : (
      <section class="pt-10">
        <h2 class="mb-5 border-primary border-b-2 pb-3 font-serif text-[clamp(24px,2.3vw,32px)] font-bold leading-none tracking-[-0.02em]">{copy.recentPublications}</h2>
        <ArchiveList entries={recentArticles} locale={locale} rule={false} />
      </section>
    )}
  </main>
</SiteLayout>
