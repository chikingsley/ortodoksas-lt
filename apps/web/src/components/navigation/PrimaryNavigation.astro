---
import NavigationItem from "./NavigationItem.astro";

interface NavOption {
  active: boolean;
  href: string;
  label: string;
}

interface Props {
  items: NavOption[];
  searchHref?: string;
  searchLabel: string;
}

const { items, searchHref, searchLabel } = Astro.props;
---

<nav class="primary-nav" aria-label={searchLabel}>
  <div class="site-width nav-scroll">
    {items.map((item) => (
      <NavigationItem active={item.active} className="primary-item" href={item.href} label={item.label} />
    ))}
    {searchHref ? <a class="nav-search" href={searchHref} aria-label={searchLabel}>
      <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4.2 4.2"></path></svg>
    </a> : null}
  </div>
</nav>
