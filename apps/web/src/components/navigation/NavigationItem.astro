---
interface Props {
  active?: boolean;
  className?: string;
  href: string;
  lang?: string;
  label: string;
}

const { active = false, className, href, lang, label } = Astro.props;
---

<a
  class:list={["navigation-item", className]}
  aria-current={active ? "page" : undefined}
  class:active
  href={href}
  lang={lang}
>
  {label}
</a>
