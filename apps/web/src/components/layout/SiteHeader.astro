---
import PublicationHeader from "./publication-header";
import { getLocaleLinks, type SiteLocale } from "../../lib/publication";

interface Props {
  locale?: SiteLocale;
}

const { locale = "lt" } = Astro.props;
const localeLinks = getLocaleLinks(Astro.url.pathname);
---

<PublicationHeader client:load currentPath={Astro.url.pathname} locale={locale} localeLinks={localeLinks} />
