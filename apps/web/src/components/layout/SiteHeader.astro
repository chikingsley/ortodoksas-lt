---
import PublicationHeader from "./publication-header.astro";
import type { SiteLocale } from "../../i18n/config";
import type { LocaleDestination } from "../publication/publication";
import { getLocaleLinks } from "../../server/publication-localization";
import { getPrimaryNavigation } from "./publication-navigation";

interface Props {
  localizedPaths: Map<string, string>;
  currentPath: string;
  locale?: SiteLocale;
  localeLinks?: Record<SiteLocale, LocaleDestination>;
}

const { localizedPaths, currentPath, locale = "lt", localeLinks: suppliedLocaleLinks } = Astro.props;
const localeLinks = suppliedLocaleLinks ?? await getLocaleLinks(currentPath);

const navigationItems = getPrimaryNavigation(
  locale,
  locale === "lt" ? undefined : (path) => localizedPaths.get(path)
);

const contactHref = locale === "lt"
  ? "/p/kontaktai_30"
  : `/${locale}${localizedPaths.get("/p/kontaktai_30") ?? "/p/kontaktai_30"}`;
---

<PublicationHeader contactHref={contactHref} currentPath={currentPath} locale={locale} localeLinks={localeLinks} navigationItems={navigationItems} />
