---
import PublicationHeader from "./publication-header";
import { getLocaleLinks, type SiteLocale } from "../../lib/publication";

interface Props {
  currentPath: string;
  locale?: SiteLocale;
}

const { currentPath, locale = "lt" } = Astro.props;
const localeLinks = getLocaleLinks(currentPath);
---

<PublicationHeader client:load currentPath={currentPath} locale={locale} localeLinks={localeLinks} />
