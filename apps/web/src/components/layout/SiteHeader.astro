---
import PublicationHeader from "./publication-header";
import type { SiteLocale } from "../../i18n/config";
import {
  getLocaleLinks,
  getLocalizedCounterpart,
} from "../../lib/publication-repository";
import { getPrimaryNavigation } from "../../navigation/publication";

interface Props {
  currentPath: string;
  locale?: SiteLocale;
}

const { currentPath, locale = "lt" } = Astro.props;
const localeLinks = await getLocaleLinks(currentPath);
const localizedPaths = new Map(
  locale === "lt"
    ? []
    : await Promise.all(
        [
          "/p/bendruomenes_21.html",
          "/p/dvasininkai.html",
          "/p/biblioteka.html",
          "/p/kalendorius.html",
        ].map(async (path) => [
          path,
          (await getLocalizedCounterpart(locale, path))?.path,
        ] as const)
      )
);
const navigationItems = getPrimaryNavigation(
  locale,
  locale === "lt" ? undefined : (path) => localizedPaths.get(path)
);
---

<PublicationHeader client:load currentPath={currentPath} locale={locale} localeLinks={localeLinks} navigationItems={navigationItems} />
