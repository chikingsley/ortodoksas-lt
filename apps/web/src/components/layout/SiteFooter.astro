---
import { ui } from "../../i18n/ui";
import type { SiteLocale } from "../../i18n/config";
import { getLocalizedCounterpart } from "../../lib/publication";
import { getContactNavigation, getPrimaryNavigation } from "../../navigation/publication";
import InstitutionalMarks from "./institutional-marks";
import "./site-footer.css";

interface Props {
  locale?: SiteLocale;
}

const { locale = "lt" } = Astro.props;
const copy = ui[locale];
const navigationItems = getPrimaryNavigation(
  locale,
  (path) => locale === "lt" ? undefined : getLocalizedCounterpart(locale, path)?.path
);
const contactItems = getContactNavigation(
  locale,
  (path) => locale === "lt" ? undefined : getLocalizedCounterpart(locale, path)?.path
);
---

<footer class="site-footer">
  <div class="site-width footer-grid">
    <div class="footer-identity">
      <InstitutionalMarks className="footer-institutional-marks" tone="reverse" />
      <div><div class="footer-brand">ortodoksas.lt</div><p>{copy.footerDescription}</p></div>
    </div>
    <div>
      <h2>{copy.navigation}</h2>
      {navigationItems.map((item) => (
        <a href={item.href} hreflang={item.targetLocale}>{item.label}</a>
      ))}
    </div>
    <div>
      <h2>{copy.contact}</h2>
      {contactItems.map((item) => (
        <a href={item.href} hreflang={item.targetLocale}>{item.label}</a>
      ))}
    </div>
  </div>
  <div class="site-width footer-base"><span>© 2026 ortodoksas.lt</span><span>{copy.institution}</span></div>
</footer>
