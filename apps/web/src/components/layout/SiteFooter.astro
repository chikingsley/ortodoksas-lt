---
import { localeUi } from "../../lib/locale-ui";
import type { SiteLocale } from "../../lib/publication";
import InstitutionalMarks from "./institutional-marks";
import "./site-footer.css";

interface Props {
  locale?: SiteLocale;
}

const { locale = "lt" } = Astro.props;
const copy = localeUi[locale];
const localized = locale !== "lt";
---

<footer class="site-footer">
  <div class="site-width footer-grid">
    <div class="footer-identity">
      <InstitutionalMarks className="footer-institutional-marks" tone="reverse" />
      <div><div class="footer-brand">ortodoksas.lt</div><p>{copy.footerDescription}</p></div>
    </div>
    <div>
      <h2>{copy.articles}</h2>
      {localized ? <a href={`/${locale}#articles`}>{copy.archive}</a> : <><a href="/p/katekizmas_12.html">Katekizmas</a><a href="/p/dvasininkai.html">Dvasininkai</a><a href="/p/biblioteka.html">Biblioteka</a></>}
    </div>
    <div>
      <h2>{localized ? copy.edition : "Susisiekti"}</h2>
      {localized ? <a href="/">{copy.backToLithuanian}</a> : <><a href="/p/kontaktai_30.html">Kontaktai</a><a href="/p/paremti.html">Paremti veiklą</a><a href="/admin/">Redakcija</a></>}
    </div>
  </div>
  <div class="site-width footer-base"><span>© 2026 ortodoksas.lt</span><span>{copy.institution}</span></div>
</footer>
