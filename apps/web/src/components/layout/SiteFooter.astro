---
import { ui } from "../../i18n/ui";
import type { SiteLocale } from "../../i18n/config";
import { getLocalizedCounterparts } from "../../server/publication-localization";
import {
  getContactNavigation,
  getPrimaryNavigation,
} from "./publication-navigation";
import PublicationLogo from "./publication-logo";

interface Props {
  locale?: SiteLocale;
}

const { locale = "lt" } = Astro.props;
const copy = ui[locale];
const paths = [
  "/p/bendruomenes_21",
  "/p/dvasininkai",
  "/p/biblioteka",
  "/p/kalendorius",
  "/p/kontaktai_30",
  "/p/paremti",
];
const localizedEntries =
  locale === "lt" ? new Map() : await getLocalizedCounterparts(locale, paths);
const localizedPaths = new Map(
  [...localizedEntries].map(([path, entry]) => [path, entry.path])
);
const navigationItems = getPrimaryNavigation(locale, (path) => localizedPaths.get(path));
const contactItems = getContactNavigation(locale, (path) => localizedPaths.get(path));
---

<footer class="border-primary border-t bg-paper pt-12 text-foreground">
  <div class="mx-auto grid w-[min(1200px,calc(100%-64px))] grid-cols-[2fr_1fr_1fr] gap-16 pb-12 max-md:grid-cols-2 max-md:gap-x-6 max-md:gap-y-8 max-sm:w-[min(1200px,calc(100%-32px))]">
    <div class="max-md:col-span-full">
      <PublicationLogo className="mb-5 w-[230px]" />
      <p class="max-w-[34ch] font-serif text-[17px] leading-normal text-muted-foreground">{copy.footerDescription}</p>
    </div>
    <div>
      <h2 class="mb-4 text-[10px] font-bold uppercase tracking-[0.14em] text-primary">{copy.navigation}</h2>
      {navigationItems.map((item) => (
        <a class="mb-2 block font-serif text-base transition-colors hover:text-primary" href={item.href} hreflang={item.targetLocale}>{item.label}</a>
      ))}
    </div>
    <div>
      <h2 class="mb-4 text-[10px] font-bold uppercase tracking-[0.14em] text-primary">{copy.contact}</h2>
      {contactItems.map((item) => (
        <a class="mb-2 block font-serif text-base transition-colors hover:text-primary" href={item.href} hreflang={item.targetLocale}>{item.label}</a>
      ))}
    </div>
  </div>
  <div class="mx-auto flex w-[min(1200px,calc(100%-64px))] justify-between gap-5 border-primary border-t py-4 text-[9px] uppercase tracking-[0.1em] text-muted-foreground max-sm:w-[min(1200px,calc(100%-32px))] max-sm:flex-col max-sm:gap-2">
    <span>© 2026 ortodoksas.lt</span>
    <span>{copy.institution}</span>
  </div>
</footer>
