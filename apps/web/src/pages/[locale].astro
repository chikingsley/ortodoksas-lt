---
import ArchiveList from "../components/archive/ArchiveList.astro";
import PageIntro from "../components/publication/PageIntro.astro";
import { type Locale, localeMetadata, localeShells } from "../i18n/config";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getArticles } from "../lib/publication-repository";
import { ui } from "../i18n/ui";

const locale = Astro.params.locale as Locale;
if (!localeShells.includes(locale)) {
  return Astro.rewrite("/404");
}
const entries = await getArticles(locale);
const localizedCopy = ui[locale];
const languageName = localeMetadata[locale].languageName;
---

<SiteLayout title={`${localizedCopy.edition} · ortodoksas.lt`} description={entries.length ? `${entries.length} ${localizedCopy.articles.toLocaleLowerCase(locale)} · ${localizedCopy.edition}.` : localizedCopy.editionUnavailable} canonicalPath={`/${locale}`} lang={locale} locale={locale}>
  <main class:list={["mx-auto w-[min(1200px,calc(100%-64px))] pb-[72px] max-sm:w-[min(1200px,calc(100%-32px))]", { "pt-12 max-sm:pb-12 max-sm:pt-8": !entries.length }]}>
    {entries.length ? <>
      <PageIntro description={`${entries.length} ${localizedCopy.articles.toLocaleLowerCase(locale)} · ${localizedCopy.edition}`} eyebrow={`${languageName} · ${localeMetadata[locale].displayCode}`} title={localizedCopy.edition} />
      <ArchiveList entries={entries} fallbackSection={languageName} id="articles" locale={locale} />
    </> : <div class="max-w-[760px] bg-muted p-[clamp(28px,6vw,72px)]" id="articles">
      <div class="text-[10px] font-bold uppercase tracking-[0.08em] text-primary">{languageName} · {localeMetadata[locale].displayCode}</div>
      <h1 class="mb-3.5 mt-2.5 font-serif text-[clamp(42px,6vw,66px)] font-bold leading-[0.98] tracking-[-0.025em]">{localizedCopy.edition}</h1>
      <p class="m-0 font-serif text-xl leading-[1.45] text-muted-foreground">{localizedCopy.editionUnavailable}</p>
      <a class="mt-5 inline-flex items-center gap-[7px] text-[11px] font-bold text-primary" href="/">{localizedCopy.backToLithuanian} →</a>
    </div>}
  </main>
</SiteLayout>
