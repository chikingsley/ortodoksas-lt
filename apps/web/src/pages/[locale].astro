---
import ArchiveList from "../components/archive/ArchiveList.astro";
import PageIntro from "../components/publication/PageIntro.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getLocalizedArticles, localeShells, type Locale } from "../lib/publication";
import { localeUi } from "../lib/locale-ui";

const copy: Record<Locale, { name: string; title: string; message: string }> = {
  en: { name: "English", title: "English edition", message: "English publications are being prepared. Browse the Lithuanian source edition in the meantime." },
  ru: { name: "Русский", title: "Русское издание", message: "Публикации на русском языке готовятся. Литовское издание доступно как исходное." },
  uk: { name: "Українська", title: "Українське видання", message: "Публікації українською мовою готуються. Литовське видання доступне як вихідне." },
  be: { name: "Беларуская", title: "Беларускае выданне", message: "Публікацыі на беларускай мове рыхтуюцца. Літоўскае выданне даступнае як зыходнае." },
};

export function getStaticPaths() {
  return localeShells.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const language = copy[locale];
const entries = getLocalizedArticles(locale);
const localizedCopy = localeUi[locale];
---

<SiteLayout title={`${language.title} · ortodoksas.lt`} description={entries.length ? `${entries.length} ${localizedCopy.articles.toLocaleLowerCase(locale)} · ${language.title}.` : language.message} canonicalPath={`/${locale}`} lang={locale} locale={locale}>
  <main class:list={["site-width", "language-shell", { "language-empty": !entries.length }]}>
    {entries.length ? <>
      <PageIntro description={`${entries.length} ${localizedCopy.articles.toLocaleLowerCase(locale)} · ${language.title}`} eyebrow={`${language.name} · ${locale.toUpperCase()}`} title={language.title} />
      <ArchiveList entries={entries} fallbackSection={language.name} id="articles" locale={locale} />
    </> : <div class="shell-card">
      <div class="eyebrow">{language.name} · {locale.toUpperCase()}</div>
      <h1>{language.title}</h1>
      <p>{language.message}</p>
      <a class="text-link" href="/">{localizedCopy.backToLithuanian} →</a>
    </div>}
  </main>
</SiteLayout>
