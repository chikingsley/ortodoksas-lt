---
import Homepage from "../components/home/Homepage.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { buildHomepageModel } from "../lib/homepage";
import { articles, catalog, sections } from "../lib/publication";

const pageDescription = "Viskas apie Ortodoksų Bažnyčią Lietuvoje ir pasaulyje, taip pat apie ortodoksų tikėjimą ir gyvenimą.";
const model = buildHomepageModel({ articles, catalog, sections });
---

<SiteLayout canonicalPath="/" title="ortodoksas.lt" description={pageDescription}>
  <Homepage model={model} />
</SiteLayout>
