---
import PublicationPage from "../components/publication/PublicationPage.astro";
import { resolvePublicationPage } from "../components/publication/publication-page-model";

const model = await resolvePublicationPage(Astro.params.path ?? "");
if (!model) {
  return Astro.rewrite("/404");
}
---

<PublicationPage model={model} />
