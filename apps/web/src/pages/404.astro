---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Puslapis nerastas · ortodoksas.lt" description="Šio adreso atkurtame ortodoksas.lt archyve nėra." canonicalPath="/404">
  <main class="mx-auto grid min-h-[55vh] w-[min(1200px,calc(100%-64px))] place-items-center content-center text-center max-sm:w-[min(1200px,calc(100%-32px))]">
    <span class="font-serif text-[70px] text-gold" aria-hidden="true">☦</span>
    <div class="text-[10px] font-bold uppercase tracking-[0.08em] text-primary">404</div>
    <h1 class="mb-2.5 mt-[7px] font-serif text-5xl font-bold">Puslapio archyve nėra</h1>
    <p class="max-w-[520px] font-serif text-lg leading-normal text-muted-foreground">Šio adreso viešoje kopijoje rasti nepavyko. Visas išsaugotas publikacijas rasite archyve.</p>
    <a class="text-[11px] font-bold text-primary" href="/archyvas">Atverti archyvą →</a>
  </main>
</SiteLayout>
