---
import ArchiveList from "../../components/archive/ArchiveList.astro";
import PageIntro from "../../components/publication/PageIntro.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { sectionSlug } from "../../lib/publication";
import { getArticles, getSections } from "../../lib/publication-repository";

const [articles, sections] = await Promise.all([getArticles(), getSections()]);
const section = sections.find((candidate) => sectionSlug(candidate) === Astro.params.slug);
if (!section) {
  return Astro.rewrite("/404");
}
const entries = articles.filter((entry) => entry.section === section);
---

<SiteLayout title={`${section} · ortodoksas.lt`} description={`Atkurtos ortodoksas.lt publikacijos skiltyje „${section}“.`} canonicalPath={`/tema/${sectionSlug(section)}`}>
  <main class="mx-auto w-[min(1200px,calc(100%-64px))] pb-[70px] max-sm:w-[min(1200px,calc(100%-32px))]">
    <PageIntro description={`${entries.length.toLocaleString("lt-LT")} atkurtos publikacijos iš viešojo ortodoksas.lt archyvo.`} eyebrow="Publikacijų skiltis" title={section} />
    <ArchiveList entries={entries} fallbackSection={section} />
  </main>
</SiteLayout>
