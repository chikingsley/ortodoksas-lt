---
import EditorialImage from "../../components/media/EditorialImage.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { cleanHtml, formatDate, getLocalizedArticles, localeShells, type Locale, type LocalizedArticle } from "../../lib/publication";
import { localeUi } from "../../lib/locale-ui";

export function getStaticPaths() {
  return localeShells.flatMap((locale) => getLocalizedArticles(locale).map((page) => ({
    params: { locale, path: page.path.slice(1).replace(/\.html$/, "") },
    props: { locale, page },
  })));
}

const { locale, page } = Astro.props as { locale: Locale; page: LocalizedArticle };
const copy = localeUi[locale];
const canonicalPath = `/${locale}${page.path}`;
const articleSchema = {
  articleSection: page.section,
  dateModified: page.published ?? undefined,
  datePublished: page.published ?? undefined,
  headline: page.title,
  keywords: page.labels.join(", "),
  mainEntityOfPage: canonicalPath,
};
---

<SiteLayout
  title={`${page.title} · ${copy.edition}`}
  description={page.description}
  canonicalPath={canonicalPath}
  image={page.hero}
  jsonLd={articleSchema}
  lang={locale}
  locale={locale}
  type="article"
>
  <main class="article-page localized-article">
    <article class="reading-column">
      <header class="article-header">
        <div class="eyebrow">{copy.edition}</div>
        <h1>{page.title}</h1>
        {page.published ? <div class="article-byline"><time datetime={page.published}>{formatDate(page.published, locale)}</time></div> : null}
        {page.hero ? <EditorialImage class="article-hero" priority src={page.hero} /> : null}
      </header>
      <div class="prose" set:html={cleanHtml(page.html, page.hero, true)}></div>
      {page.labels.length > 0 ? <footer class="article-tags">{page.labels.map((label) => <span>{label}</span>)}</footer> : null}
    </article>
  </main>
</SiteLayout>
