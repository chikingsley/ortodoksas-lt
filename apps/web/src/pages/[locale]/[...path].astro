---
import EditorialImage from "../../components/media/EditorialImage.astro";
import { getSectionLabel } from "@ortodoksas-lt/content/sections";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getTranslationDisplayState } from "@ortodoksas-lt/content/translation";
import { type Locale, localeShells } from "../../i18n/config";
import { cleanHtml, formatDate, getLithuanianCounterpart, getLocalizedPages, hasLeadFigure, type LocalizedPage } from "../../lib/publication";
import { ui } from "../../i18n/ui";

export function getStaticPaths() {
  return localeShells.flatMap((locale) => getLocalizedPages(locale).map((page) => ({
    params: { locale, path: page.path.slice(1).replace(/\.html$/, "") },
    props: { locale, page },
  })));
}

const { locale, page } = Astro.props as { locale: Locale; page: LocalizedPage };
const copy = ui[locale];
const canonicalPath = `/${locale}${page.path}`;
const original = getLithuanianCounterpart(canonicalPath);
const translationState = getTranslationDisplayState({
  kind: page.translationKind ?? "human",
  reviewStatus: page.translationReviewStatus ?? "approved",
});
const translationDisclosure = translationState === "editor_reviewed"
  ? copy.editorReviewedTranslation
  : copy.automaticTranslation;
const bodyOwnsLeadImage = hasLeadFigure(page.html);
const bodyHtml = cleanHtml(
  page.html,
  bodyOwnsLeadImage ? null : page.hero,
  page.kind === "article"
);
const articleSchema = page.kind === "article" ? {
  articleSection: page.section,
  dateModified: page.published ?? undefined,
  datePublished: page.published ?? undefined,
  headline: page.title,
  keywords: page.labels.join(", "),
  mainEntityOfPage: canonicalPath,
} : undefined;
---

<SiteLayout
  title={`${page.title} · ${copy.edition}`}
  description={page.description}
  canonicalPath={canonicalPath}
  image={page.hero}
  jsonLd={articleSchema}
  lang={locale}
  locale={locale}
  type={page.kind === "article" ? "article" : "website"}
>
  <main class="article-page localized-article">
    <article class="reading-column">
      <header class="article-header">
        <div class="eyebrow">{page.kind === "page" ? copy.edition : getSectionLabel(page.section, locale)}</div>
        <h1>{page.title}</h1>
        {page.published ? <div class="article-byline"><time datetime={page.published}>{formatDate(page.published, locale)}</time></div> : null}
        {original && translationState !== "original" ? (
          <p class="translation-disclosure">
            {translationDisclosure}
            <a href={original.path}>{copy.viewOriginal}</a>
          </p>
        ) : null}
        {page.hero && !bodyOwnsLeadImage ? <EditorialImage class="article-hero" priority src={page.hero} /> : null}
      </header>
      <div class="prose" set:html={bodyHtml}></div>
      {page.labels.length > 0 ? <footer class="article-tags">{page.labels.map((label) => <span>{label}</span>)}</footer> : null}
    </article>
  </main>
</SiteLayout>
