{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ortodoksas-lt-web",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "ortodoksas.grassinside.com", "custom_domain": true },
  ],
  "vars": {
    "ENVIRONMENT": "production",
  },
  "version_metadata": { "binding": "PUBLICATION_VERSION" },
  "durable_objects": {
    "bindings": [
      { "name": "PUBLICATION_RENDERER", "class_name": "PublicationRenderer" },
    ],
  },
  "migrations": [
    {
      "tag": "publication-renderer-v1",
      "new_sqlite_classes": ["PublicationRenderer"],
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": ["/api/*"],
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "workers_dev": false,
  "preview_urls": false,
}
