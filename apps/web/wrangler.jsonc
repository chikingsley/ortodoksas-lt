{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ortodoksas-lt-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "ortodoksas.grassinside.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "ortodoksas-studio-media",
      "remote": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ortodoksas-studio",
      "database_id": "989ce1b7-0555-47e3-a635-0e79cdf21e07",
      "migrations_dir": "../../packages/db/migrations",
      "remote": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
