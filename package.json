{
  "name": "ortodoksas-lt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @ortodoksas-lt/web build && pnpm --filter @ortodoksas-lt/studio build",
    "build:canonical": "pnpm --filter @ortodoksas-lt/web build",
    "check": "pnpm lint && pnpm typecheck:tooling && pnpm test:security && pnpm test:release && pnpm --filter @ortodoksas-lt/content test && pnpm --filter @ortodoksas-lt/editor test && pnpm --filter @ortodoksas-lt/db check && pnpm --filter @ortodoksas-lt/web check && pnpm --filter @ortodoksas-lt/studio check",
    "dev:studio": "pnpm --filter @ortodoksas-lt/studio dev",
    "dev:web": "pnpm --filter @ortodoksas-lt/web dev",
    "fix": "ultracite fix",
    "lint": "oxfmt --check && oxlint --deny-warnings",
    "lint:strict": "oxfmt --check && oxlint --deny-warnings",
    "test:security": "node --test tests/braces-security.test.mts",
    "typecheck:tooling": "pnpm --filter @ortodoksas-lt/studio exec tsc -p ../../tsconfig.tooling.json",
    "verify:cpu": "node deployment/verify-cpu.mts",
    "test:release": "node --test tests/publication-cpu.test.mts"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.3",
    "@types/braces": "3.0.5",
    "@types/node": "^26.6.5",
    "braces": "3.0.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "ultracite": "8.0.1",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@12.14.0"
}
