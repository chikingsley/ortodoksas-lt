{
  "name": "ortodoksas-lt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "articles:import": "tsx scripts/content/import-articles.ts",
    "build": "pnpm content:export && pnpm --filter @ortodoksas-lt/web build && pnpm --filter @ortodoksas-lt/studio build",
    "build:canonical": "pnpm content:export && pnpm --filter @ortodoksas-lt/web build",
    "check": "pnpm --filter @ortodoksas-lt/db check && pnpm --filter @ortodoksas-lt/web check && pnpm --filter @ortodoksas-lt/studio check",
    "content:export": "pnpm --filter @ortodoksas-lt/web exec tsx scripts/export-canonical.ts",
    "dev:studio": "pnpm --filter @ortodoksas-lt/studio dev",
    "dev:web": "pnpm --filter @ortodoksas-lt/web dev",
    "fix": "pnpm --recursive --if-present fix",
    "media:check": "pnpm --filter @ortodoksas-lt/web media:check:source",
    "media:import": "pnpm --filter @ortodoksas-lt/studio media:import"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@vitest/browser-preview": "4.1.10",
    "cheerio": "^1.2.0",
    "linkedom": "0.18.13",
    "sharp": "^0.35.3",
    "tsx": "^4.23.8",
    "ultracite": "7.10.1"
  },
  "packageManager": "pnpm@11.20.0"
}
