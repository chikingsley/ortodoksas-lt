    "@cloudflare/vite-plugin": "^1.51.0",
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "linkedom": "0.18.13",
    "sass-embedded": "^1.100.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
