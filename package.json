{
  "name": "ortodoksas-revival",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:up": "bash scripts/preview.sh up",
    "preview:status": "bash scripts/preview.sh status",
    "preview:down": "bash scripts/preview.sh down",
    "cms:local": "pnpm dlx decap-server",
    "archive:recover": "node scripts/recover-archive.mjs",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "deploy:dry-run": "wrangler deploy --config wrangler.jsonc --dry-run",
    "cf:types": "wrangler types",
    "cf:types:check": "wrangler types --check",
    "test": "pnpm test:react && pnpm test:worker",
    "test:react": "vitest run --config vitest.config.ts --exclude src/app.test.tsx",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "typecheck": "tsc -b",
    "check": "ultracite check && pnpm cf:types:check && pnpm typecheck && pnpm test && pnpm build && pnpm deploy:dry-run",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@tanstack/react-router": "^1.170.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "marked": "^18.0.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.3",
    "@cloudflare/vite-plugin": "^1.44.0",
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "astro": "^5.13.5",
    "cheerio": "^1.2.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3",
    "ultracite": "^7.9.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  },
  "packageManager": "pnpm@11.7.0"
}
