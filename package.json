{
  "name": "ortodoksas-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "cf-typegen": "wrangler types",
    "check": "ultracite check && tsc -b && vitest run && vitest run --config vitest.node.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "vite",
    "fix": "ultracite fix",
    "lint": "ultracite check",
    "media:import": "node scripts/import-recovered-media.mjs",
    "preview": "pnpm run build && vite preview",
    "studio:down": "./scripts/studio-preview.sh down",
    "studio:status": "./scripts/studio-preview.sh status",
    "studio:up": "./scripts/studio-preview.sh up",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@floating-ui/react": "^0.27.20",
    "@fontsource-variable/geist": "^5.3.0",
