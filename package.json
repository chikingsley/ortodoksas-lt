{
  "name": "ortodoksas-revival",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:up": "bash scripts/preview.sh up",
    "preview:status": "bash scripts/preview.sh status",
    "preview:down": "bash scripts/preview.sh down",
    "cms:local": "pnpm dlx decap-server",
    "archive:recover": "node scripts/recover-archive.mjs",
    "media:ingest": "node scripts/ingest-media.mjs",
    "media:recover:metadata": "node scripts/recover-media-metadata.mjs",
    "media:recover:inline": "node scripts/recover-inline-media.mjs",
    "media:recover:wayback": "node scripts/recover-wayback-media.mjs",
    "media:clean:word-artifacts": "node scripts/remove-word-media-artifacts.mjs",
    "media:assign:series": "node scripts/assign-series-media.mjs",
    "media:assign:fallbacks": "node scripts/assign-editorial-fallbacks.mjs",
    "media:queue": "node scripts/build-media-review-queue.mjs",
    "media:registry": "node scripts/build-media-registry.mjs",
    "media:research:deepseek": "node scripts/run-deepseek-media-research.mjs",
    "media:research:import": "node scripts/import-media-research.mjs",
    "media:research:source": "node scripts/import-source-media-evidence.mjs",
    "media:check:source": "node scripts/check-media-integrity.mjs source",
    "media:check:dist": "node scripts/check-media-integrity.mjs dist",
    "media:check:homepage": "node scripts/check-media-integrity.mjs source --scope homepage && node scripts/check-media-integrity.mjs dist --scope homepage",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "deploy:dry-run": "wrangler deploy --config wrangler.jsonc --dry-run",
    "cf:types": "wrangler types",
    "cf:types:check": "wrangler types --check",
    "test": "pnpm test:react && pnpm test:worker",
    "test:react": "vitest run --config vitest.config.ts --exclude src/app.test.tsx",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "typecheck": "tsc -b",
    "check": "ultracite check && pnpm media:check:source && pnpm cf:types:check && pnpm typecheck && pnpm test && pnpm build && pnpm media:check:dist && pnpm deploy:dry-run",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@tanstack/react-router": "^1.170.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "marked": "^18.0.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.3",
    "@cloudflare/vite-plugin": "^1.44.0",
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "astro": "^5.13.5",
    "cheerio": "^1.2.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3",
    "ultracite": "^7.9.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  },
  "packageManager": "pnpm@11.7.0"
}
